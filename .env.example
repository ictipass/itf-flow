# Core runtime. Deployed Prisma Postgres environments should use the pooled URL here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itf_flow"
# Migration/admin connection. For local PostgreSQL this may equal DATABASE_URL; deployed
# Prisma Postgres environments should use their direct URL here.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/itf_flow"
SESSION_SECRET="replace-with-a-unique-32-byte-random-secret"
STAFF_SESSION_IDLE_MINUTES="30"
STAFF_LOCAL_LOGIN_ENABLED="false"

# Disposable local/demo seeding only. Never enable or seed a staging/production database.
ALLOW_DEMO_SEED="false"
SEED_PASSWORD="replace-with-a-local-demo-password"

# Workspace launch v2 receiver. Deployed environments require absolute HTTPS URLs.
WORKSPACE_LAUNCH_ISSUER="http://localhost:3000"
WORKSPACE_LAUNCH_AUDIENCE="itf-flow"
WORKSPACE_LAUNCH_JWKS_URL="http://localhost:3000/api/integrations/workspace/v2/jwks"
WORKSPACE_APP_SLUG="itf-flow"
WORKSPACE_LAUNCH_TTL_SECONDS="120"
WORKSPACE_LAUNCH_CLOCK_SKEW_SECONDS="30"
WORKSPACE_MFA_STEP_UP_SECONDS="600"

# Generate these independently. The directory and interoperability values must match
# their corresponding ITF Workspace staging values; do not reuse one value for both.
WORKSPACE_DIRECTORY_SYNC_SECRET="replace-with-a-separate-32-byte-random-secret"
WORKSPACE_INTEROP_SECRET="replace-with-another-32-byte-random-secret"

NEXT_PUBLIC_WORKSPACE_URL="http://localhost:3000"
NEXT_PUBLIC_WORKSPACE_LOGOUT_URL="http://localhost:3000/logout"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Independent application approval-signing credential.
APPROVAL_SIGNING_SECRET="replace-with-a-separate-32-byte-random-secret"

# Secretariat mailbox. Never commit a real mailbox address or password.
MAIL_ENABLED="false"
MAIL_USERNAME="secretariat@example.gov.ng"
MAIL_PASSWORD=""
MAIL_IMAP_HOST="mail.itf.gov.ng"
MAIL_IMAP_PORT="993"
MAIL_IMAP_SECURE="true"
MAIL_IMAP_FOLDER="INBOX"
MAIL_SMTP_HOST="mail.itf.gov.ng"
MAIL_SMTP_PORT="465"
MAIL_SMTP_SECURE="true"
MAIL_MAX_MESSAGE_SIZE_MB="50"

# Independent secret used only by the protected scheduled email worker.
EMAIL_WORKER_SECRET="replace-with-a-separate-long-random-secret"
EMAIL_WORKER_BATCH_SIZE="20"

# Independent secret for scheduled reminders, escalation and daily digests.
WORKFLOW_WORKER_SECRET="replace-with-another-separate-long-random-secret"

# Current demo adapter. EDMS must be implemented behind the document-storage interface.
DOCUMENT_STORAGE_PROVIDER="LOCAL"
DOCUMENT_MAX_SIZE_MB="50"
DOCUMENT_SCANNER_PROVIDER="DISABLED"
DOCUMENT_OCR_PROVIDER="DISABLED"
DOCUMENT_WORKER_SECRET="replace-with-a-separate-long-random-secret"
DOCUMENT_WORKER_BATCH_SIZE="10"

# S26 non-destructive load smoke. Point only at an approved environment.
LOAD_TEST_BASE_URL="http://localhost:3001"
LOAD_TEST_REQUESTS="100"
LOAD_TEST_CONCURRENCY="10"
LOAD_TEST_MAX_P95_MS="1000"

# Backup drill URLs are intentionally omitted. Supply them only for the drill;
# BACKUP_VERIFY_DATABASE_URL must identify a disposable, isolated database.
