{
  "name": "itf-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "env:check": "tsx scripts/environment-check.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "setup:verify": "npm run env:check && npm run db:status && npm run lint",
    "test:security": "tsx --test tests/security-regression.test.ts tests/database-url.test.ts tests/workspace-launch-v2.test.ts tests/workspace-session-events.test.ts tests/session-policy.test.ts tests/workspace-directory-contract.test.ts",
    "test:assurance": "tsx --test tests/*.test.ts",
    "load:smoke": "tsx scripts/load-smoke.ts",
    "backup:verify": "powershell -ExecutionPolicy Bypass -File scripts/backup-restore-check.ps1",
    "verify": "prisma validate && npm run typecheck && eslint && next build --webpack"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "imapflow": "^1.6.5",
    "lucide-react": "^0.544.0",
    "mailparser": "^3.9.14",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5"
  }
}
