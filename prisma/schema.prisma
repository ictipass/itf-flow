generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DG_SECRETARY
  DG
  DIRECTOR
  DIVISION_HEAD
  UNIT_HEAD
  OFFICER
  RECORDS_ADMIN
  SYSTEM_ADMIN
}

enum CorrespondenceType {
  INCOMING_LETTER
  OUTGOING_LETTER
  INTERNAL_MEMO
}

enum Classification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SECRET
}

enum Priority {
  ROUTINE
  URGENT
  IMMEDIATE
}

enum CorrespondenceStatus {
  DRAFT
  SUBMITTED
  REGISTERED
  WITH_DG
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  RETURNED
}

enum IntakeSource {
  MANUAL
  PORTAL
  EMAIL
}

enum RecipientKind {
  ACTION
  COPY
}

enum WorkItemStatus {
  OPEN
  ACKNOWLEDGED
  COMPLETED
  CANCELLED
}

enum WorkPurpose {
  ACTION
  REVIEW
  CONCURRENCE
  APPROVAL
}

enum DecisionOutcome {
  RECOMMENDED
  CONCURRED
  APPROVED
  REJECTED
  RETURNED
}

enum EventType {
  DRAFTED
  DRAFT_UPDATED
  DRAFT_DELETED
  SUBMITTED
  EMAIL_IMPORTED
  CLAIMED
  RELEASED
  REGISTERED
  ACKNOWLEDGED
  MINUTED
  FORWARDED
  REFERRED
  DECISION_REQUESTED
  DECISION_RECORDED
  REVISED
  RETURNED
  RESUBMITTED
  RESOLVED
  CLOSED
  COMMENTED
}

enum MalwareScanStatus {
  NOT_SCANNED
  PENDING
  CLEAN
  QUARANTINED
  INFECTED
}

enum ActorType {
  STAFF
  EXTERNAL
  SYSTEM
}

enum BroadcastStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
  EXPIRED
}

enum BroadcastCategory {
  GENERAL
  HUMAN_RESOURCES
  POLICY
  EMERGENCY
  SYSTEM
}

enum BroadcastPriority {
  ROUTINE
  IMPORTANT
  URGENT
}

enum BroadcastScopeType {
  ORGANIZATION
  OFFICE
  DEPARTMENT
  DIVISION
  UNIT
  ROLE
  USER
}

enum BroadcastEventType {
  DRAFTED
  PUBLISHED
  READ
  ACKNOWLEDGED
  WITHDRAWN
}

model User {
  id                  String   @id @default(cuid())
  workspaceUserId     String?  @unique
  staffNumber         String?  @unique
  email               String   @unique
  name                String
  passwordHash        String?
  role                UserRole
  office              String
  department          String?
  division            String?
  unit                String?
  position            String?
  workspaceOfficeId   String?
  workspaceDepartmentId String?
  workspaceDivisionId String?
  workspaceUnitId     String?
  workspacePositionId String?
  supervisorId        String?
  supervisor          User?    @relation("ReportingLine", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports       User[]   @relation("ReportingLine")
  hierarchyLevel      Int
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdCorrespondence Correspondence[] @relation("CorrespondenceCreator")
  workItems           WorkItem[]
  events              CorrespondenceEvent[]
  claimedCorrespondence Correspondence[] @relation("CorrespondenceClaim")
  launchRedemptions   LaunchTokenRedemption[]
  broadcastGrants     BroadcastPublisherGrant[]
  createdBroadcasts   Broadcast[] @relation("BroadcastCreator")
  publishedBroadcasts Broadcast[] @relation("BroadcastPublisher")
  broadcastRecipients BroadcastRecipient[]
  broadcastEvents     BroadcastEvent[]
  requestedDecisions  DecisionRequest[] @relation("DecisionRequester")
  madeDecisions       DecisionRequest[] @relation("DecisionMaker")
  createdRevisions    CorrespondenceRevision[]

  @@index([role, isActive])
  @@index([supervisorId, isActive])
  @@index([workspaceDepartmentId])
  @@index([workspaceDivisionId])
  @@index([workspaceUnitId])
}

model BroadcastPublisherGrant {
  id                     String               @id @default(cuid())
  userId                 String
  scopeType              BroadcastScopeType
  scopeValue             String?
  allowedCategories      BroadcastCategory[]
  canRequireAcknowledgement Boolean           @default(false)
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeType, scopeValue])
  @@index([userId, isActive])
}

model Broadcast {
  id                       String              @id @default(cuid())
  title                    String
  message                  String
  category                 BroadcastCategory
  priority                 BroadcastPriority  @default(ROUTINE)
  status                   BroadcastStatus    @default(DRAFT)
  mandatoryAcknowledgement Boolean            @default(false)
  createdById              String
  publishedById            String?
  publishAt                DateTime?
  expiresAt                DateTime?
  publishedAt              DateTime?
  withdrawnAt              DateTime?
  withdrawalReason         String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  createdBy                User                @relation("BroadcastCreator", fields: [createdById], references: [id])
  publishedBy              User?               @relation("BroadcastPublisher", fields: [publishedById], references: [id])
  audiences                BroadcastAudience[]
  recipients               BroadcastRecipient[]
  events                   BroadcastEvent[]

  @@index([status, publishAt, expiresAt])
  @@index([createdById, createdAt])
}

model BroadcastAudience {
  id          String             @id @default(cuid())
  broadcastId String
  scopeType   BroadcastScopeType
  scopeValue  String?
  label       String
  broadcast   Broadcast          @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
}

model BroadcastRecipient {
  id                 String    @id @default(cuid())
  broadcastId        String
  userId             String
  recipientName      String
  recipientEmail     String
  recipientRole      String
  recipientOffice    String
  recipientDepartment String?
  recipientDivision  String?
  recipientUnit      String?
  deliveredAt        DateTime  @default(now())
  readAt             DateTime?
  acknowledgedAt     DateTime?
  broadcast          Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id])

  @@unique([broadcastId, userId])
  @@index([userId, readAt, acknowledgedAt])
}

model BroadcastEvent {
  id          String             @id @default(cuid())
  broadcastId String
  actorId     String
  type        BroadcastEventType
  detail      String?
  metadata    Json?
  createdAt   DateTime           @default(now())
  broadcast   Broadcast          @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  actor       User               @relation(fields: [actorId], references: [id])

  @@index([broadcastId, createdAt])
  @@index([actorId, createdAt])
}

model ExternalOrganization {
  id           String   @id @default(cuid())
  name         String
  contactName  String
  email        String
  phone        String?
  address      String?
  createdAt    DateTime @default(now())
  submissions  Correspondence[]

  @@index([email])
}

model Correspondence {
  id                     String               @id @default(cuid())
  referenceNumber        String               @unique
  type                   CorrespondenceType
  classification         Classification
  priority               Priority             @default(ROUTINE)
  status                 CorrespondenceStatus @default(SUBMITTED)
  intakeSource           IntakeSource         @default(MANUAL)
  subject                String
  summary                String
  body                   String?
  senderName             String
  senderReference        String?
  dateOnDocument         DateTime?
  receivedAt             DateTime             @default(now())
  dueAt                  DateTime?
  currentOwnerId         String?
  claimedById            String?
  claimedAt              DateTime?
  draftActionRecipientIds String[]             @default([])
  draftCopyRecipientIds   String[]             @default([])
  draftInstruction        String?
  draftWorkPurpose        WorkPurpose          @default(ACTION)
  createdById            String?
  externalOrganizationId String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  createdBy            User?                 @relation("CorrespondenceCreator", fields: [createdById], references: [id])
  claimedBy            User?                 @relation("CorrespondenceClaim", fields: [claimedById], references: [id], onDelete: SetNull)
  externalOrganization ExternalOrganization? @relation(fields: [externalOrganizationId], references: [id])
  attachments          Attachment[]
  workItems            WorkItem[]
  events               CorrespondenceEvent[]
  emailMessage         EmailMessage?
  decisionRequests     DecisionRequest[]
  revisions            CorrespondenceRevision[]

  @@index([status, updatedAt])
  @@index([intakeSource, status, receivedAt])
  @@index([claimedById, status])
  @@index([currentOwnerId, status])
  @@index([classification])
}

model Attachment {
  id               String         @id @default(cuid())
  correspondenceId String
  originalName     String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  sha256           String
  storageProvider  String         @default("LOCAL")
  externalDocumentId String?
  malwareScanStatus MalwareScanStatus @default(NOT_SCANNED)
  createdAt        DateTime       @default(now())
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)

  @@index([correspondenceId])
}

model EmailMessage {
  id               String         @id @default(cuid())
  correspondenceId String         @unique
  mailbox          String
  folder           String         @default("INBOX")
  uidValidity      String
  uid              Int
  messageId        String?
  fromAddress      String
  toAddresses      String[]
  ccAddresses      String[]
  sentAt           DateTime?
  importedAt       DateTime       @default(now())
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)

  @@unique([mailbox, folder, uidValidity, uid])
  @@index([messageId])
}

model MailboxSyncRun {
  id             String   @id @default(cuid())
  mailbox        String
  status         String
  importedCount  Int      @default(0)
  skippedCount   Int      @default(0)
  error          String?
  startedAt      DateTime @default(now())
  completedAt    DateTime?

  @@index([startedAt])
  @@index([status])
}

model WorkItem {
  id               String         @id @default(cuid())
  correspondenceId String
  assigneeId       String
  kind             RecipientKind
  status           WorkItemStatus @default(OPEN)
  purpose          WorkPurpose    @default(ACTION)
  instruction      String?
  dueAt            DateTime?
  assignedAt       DateTime       @default(now())
  acknowledgedAt   DateTime?
  completedAt      DateTime?
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  assignee         User           @relation(fields: [assigneeId], references: [id])
  decisionRequest  DecisionRequest?

  @@index([assigneeId, status])
  @@index([correspondenceId, status])
}

model DecisionRequest {
  id               String           @id @default(cuid())
  correspondenceId String
  workItemId       String           @unique
  requestedById    String
  purpose          WorkPurpose
  outcome          DecisionOutcome?
  decisionNote     String?
  decidedById      String?
  requestedAt      DateTime         @default(now())
  decidedAt        DateTime?
  supersededAt     DateTime?
  supersededByVersion Int?
  correspondence   Correspondence   @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  workItem         WorkItem         @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  requestedBy      User             @relation("DecisionRequester", fields: [requestedById], references: [id])
  decidedBy        User?            @relation("DecisionMaker", fields: [decidedById], references: [id])

  @@index([correspondenceId, requestedAt])
  @@index([requestedById, requestedAt])
  @@index([decidedById, decidedAt])
}

model CorrespondenceRevision {
  id               String         @id @default(cuid())
  correspondenceId String
  version          Int
  subject          String
  summary          String
  body             String?
  classification   Classification
  priority         Priority
  senderReference  String?
  dueAt            DateTime?
  attachments      Json
  changeNote       String
  createdById      String?
  createdAt        DateTime       @default(now())
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  createdBy        User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([correspondenceId, version])
  @@index([correspondenceId, createdAt])
}

model CorrespondenceEvent {
  id               String         @id @default(cuid())
  correspondenceId String
  actorId          String?
  actorType        ActorType
  type             EventType
  fromStatus       CorrespondenceStatus?
  toStatus         CorrespondenceStatus?
  minute           String?
  metadata         Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime       @default(now())
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  actor            User?          @relation(fields: [actorId], references: [id])

  @@index([correspondenceId, createdAt])
  @@index([actorId, createdAt])
}

model LaunchTokenRedemption {
  id              String   @id @default(cuid())
  tokenId         String   @unique
  workspaceUserId String
  userId          String
  expiresAt       DateTime
  redeemedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])

  @@index([workspaceUserId])
  @@index([expiresAt])
}

model ProvisioningRun {
  id            String   @id @default(cuid())
  source        String
  status        String
  receivedCount Int
  createdCount  Int      @default(0)
  updatedCount  Int      @default(0)
  inactiveCount Int      @default(0)
  error         String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([createdAt])
  @@index([status])
}
