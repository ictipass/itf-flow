generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DG_SECRETARY
  DG
  DIRECTOR
  DIVISION_HEAD
  UNIT_HEAD
  OFFICER
  RECORDS_ADMIN
  SYSTEM_ADMIN
}

enum CorrespondenceType {
  INCOMING_LETTER
  OUTGOING_LETTER
  INTERNAL_MEMO
}

enum Classification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SECRET
}

enum Priority {
  ROUTINE
  URGENT
  IMMEDIATE
}

enum CorrespondenceStatus {
  DRAFT
  SUBMITTED
  REGISTERED
  WITH_DG
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  RETURNED
}

enum IntakeSource {
  MANUAL
  PORTAL
  EMAIL
}

enum RecipientKind {
  ACTION
  COPY
}

enum WorkItemStatus {
  OPEN
  ACKNOWLEDGED
  COMPLETED
  CANCELLED
}

enum WorkPurpose {
  ACTION
  REVIEW
  CONCURRENCE
  APPROVAL
}

enum DecisionOutcome {
  RECOMMENDED
  CONCURRED
  APPROVED
  REJECTED
  RETURNED
}

enum DispatchChannel {
  OFFICIAL_EMAIL
  PHYSICAL_DELIVERY
  COURIER
  STAKEHOLDER_PORTAL
}

enum DispatchStatus {
  PREPARED
  DISPATCHED
  DELIVERED
  FAILED
}

enum NotificationType {
  ASSIGNED
  COPIED
  RETURNED
  PEER_REFERRED
  DECISION_REQUESTED
  DECISION_RECORDED
  REVISION_CREATED
  BROADCAST_PUBLISHED
  DISPATCH_FAILED
  DUE_SOON
  OVERDUE
  ESCALATED
  DAILY_DIGEST
  DELEGATION_ASSIGNED
  DELEGATION_REVOKED
}

enum DelegationKind {
  DELEGATION
  ACTING_APPOINTMENT
}

enum DelegationStatus {
  ACTIVE
  REVOKED
}

enum DelegationEventType {
  CREATED
  REVOKED
}

enum SensitiveAccessType {
  VIEW
  DOWNLOAD
  EXPORT
}

enum ExternalMembershipRole {
  OWNER
  MEMBER
}

enum ClarificationStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum PortalSecurityEventType {
  REGISTERED
  EMAIL_VERIFIED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  SUBMISSION_CREATED
  CLARIFICATION_RESPONDED
}

enum StaffAuthenticationMethod {
  LOCAL_PASSWORD
  WORKSPACE_LAUNCH
  ENTERPRISE_OIDC
}

enum IntegrationEventType {
  SESSION_CREATED
  SESSION_REVOKED
  CENTRAL_LOGOUT
  ENTITLEMENT_REVOKED
  DIRECTORY_SYNCHRONIZED
  ATTENTION_QUERIED
}

enum ScheduledAutomationStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum DuplicateReviewStatus {
  NOT_REVIEWED
  POSSIBLE_DUPLICATE
  CONFIRMED_DUPLICATE
  CLEARED
}

enum SecretariatRecordEventType {
  METADATA_RECORDED
  LOCATION_REASSIGNED
  DUPLICATE_FLAGGED
  DUPLICATE_CONFIRMED
  DUPLICATE_CLEARED
}

enum EmailOutboxStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
}

enum StaffUiMode {
  CLASSIC
  MODERN
  SOFT_UI
  GLASS
}

enum EventType {
  DRAFTED
  DRAFT_UPDATED
  DRAFT_DELETED
  SUBMITTED
  EMAIL_IMPORTED
  CLAIMED
  RELEASED
  REGISTERED
  ACKNOWLEDGED
  MINUTED
  FORWARDED
  REFERRED
  DECISION_REQUESTED
  DECISION_RECORDED
  REVISED
  DISPATCH_PREPARED
  DISPATCHED
  DELIVERY_CONFIRMED
  DELIVERY_FAILED
  RETURNED
  RESUBMITTED
  RESOLVED
  CLOSED
  COMMENTED
}

enum MalwareScanStatus {
  NOT_SCANNED
  PENDING
  CLEAN
  QUARANTINED
  INFECTED
}

enum ActorType {
  STAFF
  EXTERNAL
  SYSTEM
}

enum BroadcastStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
  EXPIRED
}

enum BroadcastCategory {
  GENERAL
  HUMAN_RESOURCES
  POLICY
  EMERGENCY
  SYSTEM
}

enum BroadcastPriority {
  ROUTINE
  IMPORTANT
  URGENT
}

enum BroadcastScopeType {
  ORGANIZATION
  OFFICE
  DEPARTMENT
  DIVISION
  UNIT
  ROLE
  USER
}

enum BroadcastEventType {
  DRAFTED
  PUBLISHED
  READ
  ACKNOWLEDGED
  WITHDRAWN
}

model User {
  id                  String   @id @default(cuid())
  workspaceUserId     String?  @unique
  staffNumber         String?  @unique
  email               String   @unique
  name                String
  passwordHash        String?
  role                UserRole
  office              String
  department          String?
  division            String?
  unit                String?
  position            String?
  workspaceOfficeId   String?
  workspaceDepartmentId String?
  workspaceDivisionId String?
  workspaceUnitId     String?
  workspacePositionId String?
  supervisorId        String?
  supervisor          User?    @relation("ReportingLine", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports       User[]   @relation("ReportingLine")
  hierarchyLevel      Int
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdCorrespondence Correspondence[] @relation("CorrespondenceCreator")
  workItems           WorkItem[]
  events              CorrespondenceEvent[]
  claimedCorrespondence Correspondence[] @relation("CorrespondenceClaim")
  launchRedemptions   LaunchTokenRedemption[]
  broadcastGrants     BroadcastPublisherGrant[]
  createdBroadcasts   Broadcast[] @relation("BroadcastCreator")
  publishedBroadcasts Broadcast[] @relation("BroadcastPublisher")
  broadcastRecipients BroadcastRecipient[]
  broadcastEvents     BroadcastEvent[]
  requestedDecisions  DecisionRequest[] @relation("DecisionRequester")
  madeDecisions       DecisionRequest[] @relation("DecisionMaker")
  createdRevisions    CorrespondenceRevision[]
  dispatchRecords     DispatchRecord[]
  receivedNotifications Notification[] @relation("NotificationRecipient")
  createdNotifications  Notification[] @relation("NotificationActor")
  updatedApplicationConfigurations ApplicationConfiguration[] @relation("ConfigurationUpdater")
  configurationChanges ConfigurationChange[] @relation("ConfigurationChanger")
  updatedReminderPolicies WorkflowReminderPolicy[] @relation("ReminderPolicyUpdater")
  updatedSecretariatRecords SecretariatRecord[] @relation("SecretariatRecordUpdater")
  secretariatRecordEvents SecretariatRecordEvent[]
  authorityDelegations Delegation[] @relation("DelegationPrincipal")
  receivedDelegations Delegation[] @relation("DelegationDelegate")
  createdDelegations Delegation[] @relation("DelegationCreator")
  revokedDelegations Delegation[] @relation("DelegationRevoker")
  delegationEvents DelegationEvent[]
  accessGroupMemberships AccessGroupMember[]
  createdAccessGroups AccessGroup[] @relation("AccessGroupCreator")
  sensitiveAccessEvents SensitiveAccessEvent[]
  approvalSignatures ApprovalSignature[]
  requestedClarifications ClarificationRequest[]
  staffSessions       StaffSession[]

  @@index([role, isActive])
  @@index([supervisorId, isActive])
  @@index([workspaceDepartmentId])
  @@index([workspaceDivisionId])
  @@index([workspaceUnitId])
}

model StaffSession {
  id                 String                    @id @default(cuid())
  userId             String
  authenticationMethod StaffAuthenticationMethod
  identityProvider   String?
  workspaceSessionId String?
  mfaAuthenticatedAt DateTime?
  stepUpUntil        DateTime?
  expiresAt          DateTime
  lastSeenAt         DateTime                  @default(now())
  revokedAt          DateTime?
  revocationReason   String?
  createdAt          DateTime                  @default(now())
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([workspaceSessionId])
  @@index([expiresAt])
}

model IntegrationEvent {
  id            String               @id @default(cuid())
  eventId       String               @unique
  correlationId String
  source        String
  type          IntegrationEventType
  userId        String?
  workspaceUserId String?
  sessionId     String?
  metadata      Json?
  createdAt     DateTime             @default(now())

  @@index([correlationId, createdAt])
  @@index([workspaceUserId, createdAt])
  @@index([type, createdAt])
}

model Delegation {
  id                 String           @id @default(cuid())
  principalId        String
  delegateId         String
  kind               DelegationKind
  status             DelegationStatus @default(ACTIVE)
  officeLabel        String
  startsAt           DateTime
  endsAt             DateTime
  canApprove         Boolean          @default(false)
  reason             String
  createdById        String
  revokedById        String?
  revokedAt          DateTime?
  revocationReason   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  principal          User             @relation("DelegationPrincipal", fields: [principalId], references: [id])
  delegate           User             @relation("DelegationDelegate", fields: [delegateId], references: [id])
  createdBy          User             @relation("DelegationCreator", fields: [createdById], references: [id])
  revokedBy          User?            @relation("DelegationRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  events             DelegationEvent[]

  @@index([delegateId, status, startsAt, endsAt])
  @@index([principalId, status, startsAt, endsAt])
}

model DelegationEvent {
  id           String              @id @default(cuid())
  delegationId String
  actorId      String
  type         DelegationEventType
  reason       String
  metadata     Json?
  createdAt    DateTime            @default(now())
  delegation   Delegation          @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  actor        User                @relation(fields: [actorId], references: [id])

  @@index([delegationId, createdAt])
  @@index([actorId, createdAt])
}

model AccessGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("AccessGroupCreator", fields: [createdById], references: [id])
  members     AccessGroupMember[]
  records     CorrespondenceAccessGroup[]

  @@index([isActive, name])
}

model AccessGroupMember {
  groupId  String
  userId   String
  addedAt  DateTime @default(now())
  group    AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId, groupId])
}

model CorrespondenceAccessGroup {
  correspondenceId String
  groupId          String
  assignedAt       DateTime @default(now())
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  group             AccessGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([correspondenceId, groupId])
  @@index([groupId, correspondenceId])
}

model SensitiveAccessEvent {
  id               String              @id @default(cuid())
  correspondenceId String
  userId           String
  type             SensitiveAccessType
  detail           String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime            @default(now())
  correspondence   Correspondence      @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [userId], references: [id])

  @@index([correspondenceId, createdAt])
  @@index([userId, createdAt])
}

model WorkflowReminderPolicy {
  id                    String   @id
  enabled               Boolean  @default(true)
  reminderLeadDays      Int      @default(2)
  escalationAfterDays   Int      @default(1)
  executiveDigestEnabled Boolean @default(true)
  timeZone              String   @default("Africa/Lagos")
  version               Int      @default(1)
  updatedById           String?
  updatedAt             DateTime @updatedAt
  updatedBy             User?    @relation("ReminderPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model ScheduledAutomationRun {
  id                 String                    @id @default(cuid())
  job                String
  status             ScheduledAutomationStatus @default(RUNNING)
  reminderCount      Int                       @default(0)
  overdueCount       Int                       @default(0)
  escalationCount    Int                       @default(0)
  digestCount        Int                       @default(0)
  errorCode          String?
  startedAt          DateTime                  @default(now())
  completedAt        DateTime?

  @@index([job, startedAt])
  @@index([status, startedAt])
}

model ApplicationConfiguration {
  id          String      @id
  staffUiMode StaffUiMode @default(CLASSIC)
  version     Int         @default(1)
  updatedById String?
  updatedAt   DateTime    @updatedAt
  updatedBy   User?       @relation("ConfigurationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model ConfigurationChange {
  id            String   @id @default(cuid())
  setting       String
  previousValue String
  newValue      String
  reason        String
  changedById   String
  createdAt     DateTime @default(now())
  changedBy     User     @relation("ConfigurationChanger", fields: [changedById], references: [id])

  @@index([setting, createdAt])
  @@index([changedById, createdAt])
}

model BroadcastPublisherGrant {
  id                     String               @id @default(cuid())
  userId                 String
  scopeType              BroadcastScopeType
  scopeValue             String?
  allowedCategories      BroadcastCategory[]
  canRequireAcknowledgement Boolean           @default(false)
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeType, scopeValue])
  @@index([userId, isActive])
}

model Broadcast {
  id                       String              @id @default(cuid())
  title                    String
  message                  String
  category                 BroadcastCategory
  priority                 BroadcastPriority  @default(ROUTINE)
  status                   BroadcastStatus    @default(DRAFT)
  mandatoryAcknowledgement Boolean            @default(false)
  createdById              String
  publishedById            String?
  publishAt                DateTime?
  expiresAt                DateTime?
  publishedAt              DateTime?
  withdrawnAt              DateTime?
  withdrawalReason         String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  createdBy                User                @relation("BroadcastCreator", fields: [createdById], references: [id])
  publishedBy              User?               @relation("BroadcastPublisher", fields: [publishedById], references: [id])
  audiences                BroadcastAudience[]
  recipients               BroadcastRecipient[]
  events                   BroadcastEvent[]

  @@index([status, publishAt, expiresAt])
  @@index([createdById, createdAt])
}

model BroadcastAudience {
  id          String             @id @default(cuid())
  broadcastId String
  scopeType   BroadcastScopeType
  scopeValue  String?
  label       String
  broadcast   Broadcast          @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
}

model BroadcastRecipient {
  id                 String    @id @default(cuid())
  broadcastId        String
  userId             String
  recipientName      String
  recipientEmail     String
  recipientRole      String
  recipientOffice    String
  recipientDepartment String?
  recipientDivision  String?
  recipientUnit      String?
  deliveredAt        DateTime  @default(now())
  readAt             DateTime?
  acknowledgedAt     DateTime?
  broadcast          Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id])

  @@unique([broadcastId, userId])
  @@index([userId, readAt, acknowledgedAt])
}

model BroadcastEvent {
  id          String             @id @default(cuid())
  broadcastId String
  actorId     String
  type        BroadcastEventType
  detail      String?
  metadata    Json?
  createdAt   DateTime           @default(now())
  broadcast   Broadcast          @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  actor       User               @relation(fields: [actorId], references: [id])

  @@index([broadcastId, createdAt])
  @@index([actorId, createdAt])
}

model ExternalOrganization {
  id           String   @id @default(cuid())
  name         String
  contactName  String
  email        String
  phone        String?
  address      String?
  createdAt    DateTime @default(now())
  submissions  Correspondence[]
  memberships ExternalOrganizationMember[]

  @@index([email])
}

model Correspondence {
  id                     String               @id @default(cuid())
  referenceNumber        String               @unique
  type                   CorrespondenceType
  classification         Classification
  priority               Priority             @default(ROUTINE)
  status                 CorrespondenceStatus @default(SUBMITTED)
  intakeSource           IntakeSource         @default(MANUAL)
  subject                String
  summary                String
  body                   String?
  senderName             String
  senderReference        String?
  dateOnDocument         DateTime?
  receivedAt             DateTime             @default(now())
  dueAt                  DateTime?
  currentOwnerId         String?
  claimedById            String?
  claimedAt              DateTime?
  draftActionRecipientIds String[]             @default([])
  draftCopyRecipientIds   String[]             @default([])
  draftInstruction        String?
  draftWorkPurpose        WorkPurpose          @default(ACTION)
  requiresApproval        Boolean              @default(false)
  createdById            String?
  externalOrganizationId String?
  submittedByExternalAccountId String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  createdBy            User?                 @relation("CorrespondenceCreator", fields: [createdById], references: [id])
  claimedBy            User?                 @relation("CorrespondenceClaim", fields: [claimedById], references: [id], onDelete: SetNull)
  externalOrganization ExternalOrganization? @relation(fields: [externalOrganizationId], references: [id])
  submittedByExternalAccount ExternalAccount? @relation(fields: [submittedByExternalAccountId], references: [id], onDelete: SetNull)
  attachments          Attachment[]
  workItems            WorkItem[]
  events               CorrespondenceEvent[]
  emailMessage         EmailMessage?
  decisionRequests     DecisionRequest[]
  revisions            CorrespondenceRevision[]
  dispatchRecords       DispatchRecord[]
  secretariatRecord     SecretariatRecord? @relation("SecretariatRecordCorrespondence")
  duplicateFlags        SecretariatRecord[] @relation("SecretariatDuplicateOf")
  accessGroups          CorrespondenceAccessGroup[]
  sensitiveAccessEvents SensitiveAccessEvent[]
  approvalSignatures    ApprovalSignature[]
  clarificationRequests ClarificationRequest[]

  @@index([status, updatedAt])
  @@index([intakeSource, status, receivedAt])
  @@index([claimedById, status])
  @@index([currentOwnerId, status])
  @@index([classification])
}

model ExternalAccount {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  verifiedAt    DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  memberships   ExternalOrganizationMember[]
  submissions   Correspondence[]
  verificationTokens ExternalEmailVerificationToken[]
  clarificationResponses ClarificationRequest[]
  @@index([isActive, verifiedAt])
}

model ExternalOrganizationMember {
  organizationId String
  accountId      String
  role           ExternalMembershipRole @default(MEMBER)
  joinedAt       DateTime @default(now())
  organization   ExternalOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        ExternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@id([organizationId, accountId])
  @@index([accountId, organizationId])
}

model ExternalEmailVerificationToken {
  id String @id @default(cuid())
  accountId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  account ExternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([accountId, expiresAt])
}

model PortalSecurityEvent {
  id String @id @default(cuid())
  emailHash String
  ipAddress String
  type PortalSecurityEventType
  createdAt DateTime @default(now())
  @@index([emailHash, type, createdAt])
  @@index([ipAddress, type, createdAt])
}

model ClarificationRequest {
  id String @id @default(cuid())
  correspondenceId String
  requestedById String
  question String
  status ClarificationStatus @default(OPEN)
  response String?
  respondedByExternalAccountId String?
  requestedAt DateTime @default(now())
  respondedAt DateTime?
  closedAt DateTime?
  correspondence Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  requestedBy User @relation(fields: [requestedById], references: [id])
  respondedByExternalAccount ExternalAccount? @relation(fields: [respondedByExternalAccountId], references: [id], onDelete: SetNull)
  @@index([correspondenceId, requestedAt])
  @@index([status, requestedAt])
}

model SecretariatRecord {
  id                        String                @id @default(cuid())
  correspondenceId          String                @unique
  scanDesk                   String
  scannedAt                  DateTime
  pageCount                  Int
  currentLocation            String
  physicalFileReference      String?
  trackingCode               String                @unique
  duplicateStatus            DuplicateReviewStatus @default(NOT_REVIEWED)
  duplicateOfCorrespondenceId String?
  duplicateReason            String?
  notes                      String?
  updatedById                String
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  correspondence            Correspondence         @relation("SecretariatRecordCorrespondence", fields: [correspondenceId], references: [id], onDelete: Cascade)
  duplicateOf               Correspondence?        @relation("SecretariatDuplicateOf", fields: [duplicateOfCorrespondenceId], references: [id], onDelete: SetNull)
  updatedBy                 User                   @relation("SecretariatRecordUpdater", fields: [updatedById], references: [id])
  events                    SecretariatRecordEvent[]

  @@index([currentLocation, updatedAt])
  @@index([duplicateStatus, updatedAt])
  @@index([duplicateOfCorrespondenceId])
}

model SecretariatRecordEvent {
  id                 String                     @id @default(cuid())
  secretariatRecordId String
  actorId            String
  type               SecretariatRecordEventType
  fromLocation       String?
  toLocation         String?
  reason             String
  metadata           Json?
  createdAt          DateTime                   @default(now())
  secretariatRecord  SecretariatRecord          @relation(fields: [secretariatRecordId], references: [id], onDelete: Cascade)
  actor              User                       @relation(fields: [actorId], references: [id])

  @@index([secretariatRecordId, createdAt])
  @@index([actorId, createdAt])
}

model Attachment {
  id               String         @id @default(cuid())
  correspondenceId String
  originalName     String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  sha256           String
  storageProvider  String         @default("LOCAL")
  externalDocumentId String?
  malwareScanStatus MalwareScanStatus @default(NOT_SCANNED)
  createdAt        DateTime       @default(now())
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)

  @@index([correspondenceId])
}

model EmailMessage {
  id               String         @id @default(cuid())
  correspondenceId String         @unique
  mailbox          String
  folder           String         @default("INBOX")
  uidValidity      String
  uid              Int
  messageId        String?
  fromAddress      String
  toAddresses      String[]
  ccAddresses      String[]
  sentAt           DateTime?
  importedAt       DateTime       @default(now())
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)

  @@unique([mailbox, folder, uidValidity, uid])
  @@index([messageId])
}

model MailboxSyncRun {
  id             String   @id @default(cuid())
  mailbox        String
  status         String
  importedCount  Int      @default(0)
  skippedCount   Int      @default(0)
  error          String?
  startedAt      DateTime @default(now())
  completedAt    DateTime?

  @@index([startedAt])
  @@index([status])
}

model WorkItem {
  id               String         @id @default(cuid())
  correspondenceId String
  assigneeId       String
  kind             RecipientKind
  status           WorkItemStatus @default(OPEN)
  purpose          WorkPurpose    @default(ACTION)
  instruction      String?
  dueAt            DateTime?
  assignedAt       DateTime       @default(now())
  acknowledgedAt   DateTime?
  completedAt      DateTime?
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  assignee         User           @relation(fields: [assigneeId], references: [id])
  decisionRequest  DecisionRequest?

  @@index([assigneeId, status])
  @@index([correspondenceId, status])
}

model DecisionRequest {
  id               String           @id @default(cuid())
  correspondenceId String
  workItemId       String           @unique
  requestedById    String
  purpose          WorkPurpose
  outcome          DecisionOutcome?
  decisionNote     String?
  decidedById      String?
  requestedAt      DateTime         @default(now())
  decidedAt        DateTime?
  supersededAt     DateTime?
  supersededByVersion Int?
  correspondence   Correspondence   @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  workItem         WorkItem         @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  requestedBy      User             @relation("DecisionRequester", fields: [requestedById], references: [id])
  decidedBy        User?            @relation("DecisionMaker", fields: [decidedById], references: [id])
  signature        ApprovalSignature?

  @@index([correspondenceId, requestedAt])
  @@index([requestedById, requestedAt])
  @@index([decidedById, decidedAt])
}

model ApprovalSignature {
  id                     String   @id @default(cuid())
  decisionRequestId      String   @unique
  correspondenceId       String
  revisionId             String
  revisionVersion        Int
  documentDigest         String
  canonicalPayload       Json
  signatureValue         String
  algorithm              String   @default("HMAC-SHA256")
  keyId                   String
  authenticationMethod   String
  signerId               String
  signerName             String
  signerRole             String
  signerPosition         String?
  authorityPrincipalId   String?
  authorityPrincipalName String?
  delegationId           String?
  signedAt               DateTime
  createdAt              DateTime @default(now())
  decisionRequest        DecisionRequest @relation(fields: [decisionRequestId], references: [id], onDelete: Cascade)
  correspondence         Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  revision               CorrespondenceRevision @relation(fields: [revisionId], references: [id])
  signer                 User @relation(fields: [signerId], references: [id])

  @@index([correspondenceId, signedAt])
  @@index([signerId, signedAt])
  @@index([documentDigest])
}

model CorrespondenceRevision {
  id               String         @id @default(cuid())
  correspondenceId String
  version          Int
  subject          String
  summary          String
  body             String?
  classification   Classification
  priority         Priority
  senderReference  String?
  dueAt            DateTime?
  attachments      Json
  changeNote       String
  createdById      String?
  createdAt        DateTime       @default(now())
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  createdBy        User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  approvalSignatures ApprovalSignature[]

  @@unique([correspondenceId, version])
  @@index([correspondenceId, createdAt])
}

model DispatchRecord {
  id                    String          @id @default(cuid())
  correspondenceId      String
  outgoingReference     String          @unique
  channel               DispatchChannel
  status                DispatchStatus  @default(PREPARED)
  recipientName         String
  recipientOrganization String?
  recipientEmail        String?
  recipientAddress      String?
  trackingNumber        String?
  dispatchNote          String?
  deliveryNote          String?
  createdById           String
  dispatchedAt          DateTime?
  deliveredAt           DateTime?
  failedAt              DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  correspondence        Correspondence  @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  createdBy             User            @relation(fields: [createdById], references: [id])

  @@index([correspondenceId, createdAt])
  @@index([status, createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  actorId     String?
  type        NotificationType
  title       String
  message     String
  href        String
  sourceType  String
  sourceId    String
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  user        User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([userId, sourceType, sourceId, type])
  @@index([userId, readAt, createdAt])
}

model EmailOutbox {
  id             String            @id @default(cuid())
  idempotencyKey String            @unique
  userId         String?
  toAddress      String
  subject        String
  textBody       String
  status         EmailOutboxStatus @default(QUEUED)
  attemptCount   Int               @default(0)
  maxAttempts    Int               @default(5)
  nextAttemptAt  DateTime          @default(now())
  lockedAt       DateTime?
  sentAt         DateTime?
  lastErrorCode  String?
  sourceType     String
  sourceId       String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  attempts       EmailDeliveryAttempt[]

  @@index([status, nextAttemptAt])
  @@index([sourceType, sourceId])
}

model EmailDeliveryAttempt {
  id          String      @id @default(cuid())
  outboxId    String
  attempt     Int
  successful  Boolean
  errorCode   String?
  attemptedAt DateTime    @default(now())
  outbox      EmailOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@unique([outboxId, attempt])
  @@index([attemptedAt])
}

model CorrespondenceEvent {
  id               String         @id @default(cuid())
  correspondenceId String
  actorId          String?
  actorType        ActorType
  type             EventType
  fromStatus       CorrespondenceStatus?
  toStatus         CorrespondenceStatus?
  minute           String?
  metadata         Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime       @default(now())
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  actor            User?          @relation(fields: [actorId], references: [id])

  @@index([correspondenceId, createdAt])
  @@index([actorId, createdAt])
}

model LaunchTokenRedemption {
  id              String   @id @default(cuid())
  tokenId         String   @unique
  workspaceUserId String
  userId          String
  expiresAt       DateTime
  redeemedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])

  @@index([workspaceUserId])
  @@index([expiresAt])
}

model ProvisioningRun {
  id            String   @id @default(cuid())
  source        String
  status        String
  receivedCount Int
  createdCount  Int      @default(0)
  updatedCount  Int      @default(0)
  inactiveCount Int      @default(0)
  error         String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([createdAt])
  @@index([status])
}
